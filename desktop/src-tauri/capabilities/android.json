{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "android",
  "description": "Permissions for Cowdrey.PDF on Android phones and tablets",
  "windows": [
    "main"
  ],
  "platforms": [
    "android"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "sharekit:default",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file"
  ]
}
